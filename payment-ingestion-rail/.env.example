# =============================================================================
# Payment Ingestion Rail — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the real .env file — it contains secrets.
# .env is already listed in .gitignore.
# =============================================================================

# --- Databricks Connection ---
# Find these in: Databricks UI → SQL Warehouses → your warehouse → Connection details
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi_your_personal_access_token_here

# Databricks Warehouse ID (used by Airflow DAG for SQL execution)
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Airflow Variables (used by DAG templates)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# --- Kafka Connection ---
# For local Docker: localhost:9092
# For production Confluent Cloud: pkc-xxxxx.region.aws.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=payment_transactions
KAFKA_BRONZE_TOPIC=payment_bronze
KAFKA_SILVER_TOPIC=payment_silver
KAFKA_GOLD_TOPIC=payment_gold

# --- Producer Tuning (optional) ---
NUM_PRODUCER_THREADS=4
PRODUCER_DURATION_SECONDS=60

# --- Databricks Loader Tuning (optional) ---
LOADER_BATCH_SIZE=500
LOADER_BATCH_TIMEOUT=5

# --- Java / Hadoop (required for local PySpark / Delta Lake dev) ---
# On Windows, point to your JDK and winutils installation:
#   JAVA_HOME=C:\Program Files\Amazon Corretto\jdk17.0.19_10
#   HADOOP_HOME=C:\Hadoop
# On Linux/macOS, usually set system-wide via ~/.bashrc or ~/.zshrc.
JAVA_HOME=/path/to/your/jdk
HADOOP_HOME=/path/to/your/hadoop
